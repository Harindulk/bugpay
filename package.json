{
  "name": "bugpay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --test-reporter=dot lib/ eval/ mcp/",
    "mcp": "node --env-file-if-exists=.env.local mcp/server.ts",
    "eval": "node --env-file-if-exists=.env.local eval/run.ts",
    "live": "node --env-file-if-exists=.env.local scripts/live.ts",
    "proof": "npm run live && npm run eval && npm run shots",
    "shots": "node scripts/shots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
