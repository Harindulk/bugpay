# Copy to .env.local and fill in. Leave a pair empty to run that side in mock mode.

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, hosted only: id of a webhook on that app pointing at https://<host>/api/webhooks/paypal (payout events).
# With it the Payouts ledger updates live; without it, use "Check statuses with PayPal".
PAYPAL_WEBHOOK_ID=
# Optional, for npm run live: a sandbox Personal account email (Testing tools > Sandbox accounts), so the payout lands
SANDBOX_TESTER_EMAIL=

# Claude (console.anthropic.com > API keys). Without it, triage falls back to keyword rules.
ANTHROPIC_API_KEY=

# Hosted demo only: when set, paying, approving, funding, the rules, the agent and Reset demo ask for it.
# Leave empty locally. The tester form stays open either way.
STUDIO_PASSCODE=
